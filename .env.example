# Kultura Radio — variables de entorno
# Copia este archivo a `.env` (en el host donde corre SUB/WAVE, p. ej.
# /opt/subwave/.env) y llena tus valores. NUNCA subas el .env real a git.

# --- Cerebro del DJ y cápsulas (Claude / Anthropic) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx

# --- Voz cloud para cápsulas (opcional; sin esto usa el TTS local) ---
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxx

# --- Biblioteca musical (Navidrome / Subsonic) ---
# Usuario de solo-lectura que usan la rotación y las cápsulas.
SUBSONIC_PASS=tu-password-de-navidrome

# --- Controller SUB/WAVE ---
ADMIN_PASS=tu-password-admin

# --- Tráfico local (DriveNC / NCDOT — API key gratuita) ---
# Pídela en https://drivenc.gov (developer API key).
DRIVENC_KEY=xxxxxxxxxxxxxxxx

# --- DJ humano en vivo (Icecast harbor en radio.liq, puerto 8090) ---
LIVE_DJ_PASSWORD=cambia-esta-clave
